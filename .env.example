# Copy to .env and fill in. .env is git-ignored. URL-encode special characters in passwords.
# Unset, manage.py uses config.settings.dev and gunicorn (config/wsgi.py) config.settings.prod.
# DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
# Fixed hosts Django answers (production: .your-domain.com). Clients' custom domains added in
# the console are answered too, without being listed here. Default: .localhost
# DJANGO_ALLOWED_HOSTS=.localhost,localhost,127.0.0.1
# New clients get <slug>.<TENANT_BASE_DOMAIN>.
# TENANT_BASE_DOMAIN=localhost
# LOG_LEVEL=INFO

# Runtime role: subject to row-level security (ops/db/bootstrap.sql creates the roles).
DATABASE_URL=postgres://payroll_rw:CHANGE_ME@localhost:5432/payroll
# Owner role: runs migrations (`manage.py migrate --database owner`) and the test suite.
DATABASE_OWNER_URL=postgres://payroll_owner:CHANGE_ME@localhost:5432/payroll
# Tests only: another database URL for the owner role (default: DATABASE_OWNER_URL). Never a
# superuser: superusers bypass row-level security and the isolation tests would prove nothing.
# TEST_DATABASE_URL=
# Seconds a database connection is kept open (0: one per request).
# DB_CONN_MAX_AGE=0

# The platform admin's host (no tenant): Django admin, clients, plans, features.
PLATFORM_HOSTS=admin.localhost

# PII encryption (required in production). Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
BLIND_INDEX_KEY=

# Client traffic: default requests per minute per client (0 = no limit), and how slow a request
# must be to count as slow.
TENANT_REQUESTS_PER_MINUTE=600
TRAFFIC_SLOW_MS=1000

# E-mail (development writes them to var/mail when EMAIL_URL is empty).
# Example: smtp+tls://user:password@smtp.example.com:587
EMAIL_URL=
DEFAULT_FROM_EMAIL=no-reply@example.com
# Defaults: https and no port in production; http and :8000 in development.
# SITE_SCHEME=https
# SITE_PORT=

# Production cache shared by every process (default: a file cache under var/cache).
CACHE_URL=

# Uploads (one folder per client). Served only through the application, never by nginx.
# MEDIA_ROOT=var/media

# Background jobs (manage.py run_worker): idle wait between polls.
# JOBS_POLL_SECONDS=2

# The mobile app's tokens are signed with DJANGO_SECRET_KEY unless MOBILE_JWT_KEY is set
# (changing either signs every phone out).
# MOBILE_JWT_KEY=

# WhatsApp: the gateway in ops/wa-gateway (node server.mjs), reached by the web app and the
# worker. Without it, development keeps messages in memory (WHATSAPP_CONSOLE).
# WA_GATEWAY_URL=http://127.0.0.1:3002
# WA_GATEWAY_KEY=
